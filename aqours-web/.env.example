VITE_API_URL=http://localhost:4000/api/v1
# Public browser-only Geoapify key for OSM Bright raster tiles.
# Restrict this key by allowed origins. Never use the private API geocoding key.
VITE_GEOAPIFY_MAPS_API_KEY=
# Optional raster tile template overrides Geoapify, for example https://tiles.example.test/{z}/{x}/{y}.png
VITE_MAP_TILE_URL=
# Additional attribution required by an alternate raster provider (OSM attribution stays visible).
VITE_MAP_ATTRIBUTION=
# VITE_MAP_STYLE_URL is no longer supported by the supplier Leaflet map.
