{
  "name": "aqours-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "TSX_DISABLE_CACHE=1 node --import tsx --test --experimental-test-isolation=none tests/*.test.ts"
  },
  "dependencies": {
    "@aqours/contracts": "file:../aqours-contracts",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.0",
    "globals": "^17.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.3.0"
  }
}
