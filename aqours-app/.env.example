# Public configuration only; both values are compiled into the Android bundle.
# Android emulator: http://10.0.2.2:4000/api/v1
# Phone: use the API host's reachable LAN address. Production requires HTTPS.
EXPO_PUBLIC_API_URL=https://api.example.invalid/api/v1
# Empty uses the OpenStreetMap street default; explicit styles override it.
EXPO_PUBLIC_MAP_STYLE_URL=
# Optional public raster template for the default style.
EXPO_PUBLIC_MAP_TILE_URL=
