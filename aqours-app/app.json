{
  "expo": {
    "name": "Aqours",
    "slug": "aqours-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/aqours.png",
    "scheme": "aqoursapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/aqours.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#e7f3f1",
        "foregroundImage": "./assets/images/aqours.png",
        "monochromeImage": "./assets/images/aqours.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.aqours.customer",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/aqours-q-logo.svg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#faf8f5",
          "image": "./assets/images/aqours.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Aqours to locate this reported water problem. You can use an address instead."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose optional report photos.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "platforms": [
      "android"
    ]
  }
}
