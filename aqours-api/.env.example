# Placeholder values only. Fill a private aqours-api/.env for npm runtime scripts.
# Existing process environment variables override this file; keep secrets uncommitted.
DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:<port>/<database>
PORT=4000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
SESSION_DAYS=7
# Both Geoapify variables are required to enable geocoding; unset means honest 503 fallback.
GEOAPIFY_API_KEY=<server-only-provider-key>
GEOCODE_SIGNING_SECRET=<random-server-only-signing-secret>
# Fictional Philippine demo defaults; set a documented region bias/filter for the supplier.
# Explicit empty values disable the respective restriction or preference.
GEOAPIFY_BIAS=countrycode:ph
GEOAPIFY_FILTER=countrycode:ph
GEOAPIFY_TIMEOUT_MS=5000
# Absolute or current-directory-relative path, resolved and required inside the Aqours project.
ATTACHMENT_DIR=<project-path>/aqours-api/storage/attachments
# Explicit nonproduction fixture seed opt-in. Never enable for real customer data.
SEED_DEMO=1
