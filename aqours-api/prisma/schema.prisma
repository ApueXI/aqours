}

model Supplier {
  id String @id @db.Uuid
  version Int @default(1)
  storedAt DateTime @default(now()) @db.Timestamptz(6) @map("stored_at")
  changedAt DateTime @default(now()) @db.Timestamptz(6) @map("changed_at")
  entity Entity @relation(fields: [id], references: [id], onDelete: Restrict)
  monitoringConfigs MonitoringConfig[]
  monitoringForecasts MonitoringForecast[]
  monitoringWork MonitoringWork[]
  monitoringWarnings MonitoringWarning[]
  monitoringBands MonitoringBands?
  name String @map("name")
  demo Boolean @map("demo")
  @@index([storedAt, id])
  @@map("suppliers")
}

