{
  "name": "aqours-release",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "contracts": "npm --prefix aqours-contracts run build",
    "typecheck": "npm --prefix aqours-contracts run typecheck && npm --prefix aqours-api run typecheck && npm --prefix aqours-web run typecheck && npm --prefix aqours-app run typecheck && tsc -p verification/tsconfig.json --noEmit",
    "lint": "npm --prefix aqours-api run lint && npm --prefix aqours-web run lint && npm --prefix aqours-app run lint",
    "build": "npm run contracts && npm --prefix aqours-api run build && npm --prefix aqours-web run build",
    "test:api": "node --experimental-strip-types --experimental-test-isolation=none --test --test-concurrency=1 verification/*.test.ts",
    "test:browser": "node --experimental-strip-types verification/browser.ts",
    "check:repository": "python3 -B scripts/check_repository.py",
    "test:addresses": "node --experimental-strip-types verification/browser-psgc.ts",
    "test:map": "node --experimental-strip-types verification/browser-map.ts",
    "test:maintenance": "node --experimental-strip-types verification/browser-maintenance.ts",
    "test:seed": "node --experimental-strip-types verification/seed.ts",
    "test:recovery": "node --experimental-strip-types verification/browser-recovery.ts",
    "test:operations": "node --experimental-strip-types verification/browser-operations.ts",
    "test:quality": "node --experimental-strip-types verification/browser-quality.ts",
    "test:migration": "node --experimental-strip-types verification/prisma-upgrade.ts",
    "test:weather": "TSX_DISABLE_CACHE=1 node --import ./aqours-api/node_modules/tsx/dist/loader.mjs --test --experimental-test-isolation=none verification/weather-http.ts",
    "test:weather:browser": "TSX_DISABLE_CACHE=1 node --import ./aqours-api/node_modules/tsx/dist/loader.mjs verification/browser-weather.ts",
    "test:distribution": "TSX_DISABLE_CACHE=1 node --import ./aqours-api/node_modules/tsx/dist/loader.mjs --test --experimental-test-isolation=none --test-concurrency=1 verification/distribution-http.ts",
    "test:distribution:browser": "TSX_DISABLE_CACHE=1 node --import ./aqours-api/node_modules/tsx/dist/loader.mjs verification/browser-distribution.ts",
    "test:ux": "node --experimental-strip-types verification/browser-ux.ts",
    "test:seed-upgrade": "TSX_DISABLE_CACHE=1 node --import ./aqours-api/node_modules/tsx/dist/loader.mjs verification/seed-laguna-upgrade.ts",
    "test:laguna:browser": "node --experimental-strip-types verification/browser-laguna.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
