# Compose only. Copy to ignored .env yourself; generate a private password.
POSTGRES_USER=aqours
POSTGRES_PASSWORD=replace-with-a-locally-generated-password
POSTGRES_DB=aqours
POSTGRES_PORT=5432
# Absolute path in this repository; create this directory before docker compose up.
AQOURS_PGDATA_PATH=/absolute/path/to/aqours/.local/container-postgres

# Optional verification configuration, not consumed by application bundles.
AQOURS_TEST_API=http://127.0.0.1:4000/api/v1
AQOURS_TEST_WEB=http://localhost:5173

# Optional private backup/restore tooling; server-only. Load explicitly when needed.
# DATABASE_URL and ATTACHMENT_DIR are also documented in aqours-api/.env.example.
DATABASE_URL=postgresql://aqours:replace-with-local-password@127.0.0.1:5432/aqours
ATTACHMENT_DIR=/absolute/path/to/aqours/aqours-api/storage/attachments
AQOURS_BACKUP_DIR=/absolute/path/to/aqours/.local/backups/choose-a-new-directory
AQOURS_RESTORE_DATABASE_URL=postgresql://aqours:replace-with-local-password@127.0.0.1:5432/aqours_restore

# Isolated fault-injection test database; name must end _test. Never target real data.
AQOURS_TEST_DATABASE_URL=postgresql://aqours:replace-with-test-password@127.0.0.1:5432/aqours_test
